# Onde o backend QLAREO está ouvindo (o `npm start` da raiz do projeto).
QLAREO_API_URL=http://localhost:3000

# A mesma chave definida como QLAREO_API_KEY no backend.
#
# NÃO use o prefixo NEXT_PUBLIC_: esta variável é lida apenas em Server
# Components (lib/api.ts) e vai no header `x-api-key` numa chamada
# servidor→servidor. Com o prefixo, ela seria embutida no bundle do browser e
# qualquer visitante leria o faturamento da loja.
QLAREO_API_KEY=
