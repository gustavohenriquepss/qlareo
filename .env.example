# Credenciais da conta VTEX que o QLAREO vai consultar.
# NUNCA versione o .env real. Estas chaves leem os pedidos da loja.
# Gere o par appKey/appToken no Admin VTEX com o papel "OMS - View order".
VTEX_ACCOUNT=minhaloja
VTEX_APP_KEY=vtexappkey-minhaloja-XXXXXX
VTEX_APP_TOKEN=coloque-o-token-aqui
# Opcional: ambiente (default vtexcommercestable.com.br)
# VTEX_ENVIRONMENT=vtexcommercestable.com.br

# Porta do servidor QLAREO (default 3000)
PORT=3000

# Chave que protege o endpoint do PRÓPRIO QLAREO (header x-api-key).
# Sem ela, qualquer um com a URL lê o faturamento. Defina em produção.
QLAREO_API_KEY=troque-por-um-segredo-forte

# Postgres. COM esta variável, os relatórios leem do banco (produção).
# SEM ela, o QLAREO usa store em memória (dev/demo; começa vazio).
# Suba o Postgres local com: docker compose up -d
DATABASE_URL=postgres://qlareo:qlareo@localhost:5432/qlareo

# ATENÇÃO EM PRODUÇÃO — dois roles, não um.
#
# A RLS (db/migrations/005_rls.sql) só protege quem NÃO é dono das tabelas.
# `ENABLE ROW LEVEL SECURITY` sem FORCE não se aplica ao dono, e é isso que
# mantém as migrations aplicáveis. Se a aplicação conectar com o role dono, a
# RLS some em silêncio — nada quebra, nada avisa, e a segunda tranca deixa de
# existir.
#
#   - a APP conecta com um usuário que herda `qlareo_app`
#     (sem SUPERUSER, sem BYPASSRLS);
#   - `npm run migrate` conecta com o DONO das tabelas.
#
# O role de privilégio `qlareo_app` é criado pela própria migration 005, sem
# LOGIN e sem senha (senha não entra em arquivo versionado). O usuário de login
# é criado no provisionamento:
#
#   CREATE ROLE qlareo_web LOGIN PASSWORD '...';
#   GRANT qlareo_app TO qlareo_web;
#
# Em dev com o docker-compose, o mesmo usuário faz as duas coisas — e por isso
# a RLS NÃO está de fato exercitada em dev. Quem testa isso são os testes de
# integração, que trocam de role com SET LOCAL ROLE:
#
#   TEST_DATABASE_URL=postgres://qlareo:qlareo@localhost:5432/qlareo npm test
