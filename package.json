{
  "name": "qlareo",
  "version": "0.1.0",
  "description": "QLAREO — relatórios de vendas simples e confiáveis para lojistas VTEX (standalone).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --import ./register-ts.mjs server/start.ts",
    "sync": "node --import ./register-ts.mjs scripts/sync.ts",
    "migrate": "node --import ./register-ts.mjs scripts/migrate.ts",
    "offboard": "node --import ./register-ts.mjs scripts/offboard.ts",
    "demo": "node --import ./register-ts.mjs demo.ts",
    "seed": "node --import ./register-ts.mjs scripts/seed-dev-server.ts",
    "test": "node --import ./register-ts.mjs --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
